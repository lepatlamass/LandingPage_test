{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://studio--backgrounds-on-demand.us-central1.hosted.app/",
        "type": 308
      },
      {
        "source": "/:path*",
        "destination": "https://studio--backgrounds-on-demand.us-central1.hosted.app/:path",
        "type": 308
      }
    ]
  },
  "apphosting": {
    "backendId": "studio",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ],
    "alwaysDeployFromSource": true
  }
}
